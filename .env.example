# Polar
POLAR_ACCESS_TOKEN=      # Organization Access Token with checkouts:read, checkouts:write, orders:read
POLAR_ENV=production     # "production" or "sandbox"
POLAR_PRODUCT_SINGLE=    # $14 one-time product, one child
POLAR_PRODUCT_FAMILY=    # $19 one-time product, 2 to 4 children
# Optional
NEXT_PUBLIC_SITE_URL=    # e.g. https://littlenorthpole.com
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=   # e.g. hello@littlenorthpole.com
